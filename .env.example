# =============================================================================
# Variáveis de ambiente — ecommerce-premium
# Copie este arquivo para .env.local e preencha com seus valores reais
# NUNCA comite .env.local no Git
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (obrigatório para todas as fases)
# Encontre em: https://supabase.com/dashboard/project/<id>/settings/api
# ---------------------------------------------------------------------------

# URL do projeto Supabase (pública — pode ir ao frontend)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave anon/pública (pode ir ao frontend — limitada por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Chave de service role (SEGREDO — apenas no servidor, nunca no frontend)
# Bypassa RLS — usar somente em Route Handlers / Server Actions protegidos
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---------------------------------------------------------------------------
# SupraPay (gateway de pagamento ativo — Pix embutido no checkout)
# A loja não vende mais no cartão de crédito; só Pix.
# Credenciais geradas no painel SupraPay (app.suprapay.com.py)
# ---------------------------------------------------------------------------

# Opcional — só preencher se a SupraPay mudar a base URL (ex: sandbox).
# Default (usado se não definida): https://app.suprapay.com.py/api/v1/integrations
SUPRAPAY_BASE_URL=

SUPRAPAY_API_KEY=
SUPRAPAY_API_SECRET=

# Segredo do webhook, gerado ao registrar a URL de callback no painel SupraPay.
SUPRAPAY_WEBHOOK_SECRET=

# URL base da aplicação (para webhooks e redirects do gateway)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PicPay (LEGADO — mantido só como caminho de rollback do SupraPay)
# Não preencher a não ser que precise desativar a SupraPay temporariamente.
# Token da loja em: https://ecommerce.picpay.com (Vendas Online > Credenciais)
# ---------------------------------------------------------------------------

PICPAY_TOKEN=

# ---------------------------------------------------------------------------
# API de Frete (Fase 3 — não preencher agora)
# Melhor Envio: https://melhorenvio.com.br/developers
# ---------------------------------------------------------------------------

MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CEP_ORIGIN=01310100

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------

NODE_ENV=development
